[Unit]
Description=Apply fixed ARC Hub GitHub update after owner approval
Wants=network-online.target
After=network-online.target
ConditionPathExists=/var/lib/arc-hub/updates/request

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/arc-update-runner
TimeoutStartSec=360
UMask=0077
NoNewPrivileges=true
